rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/conversations
// Document ID: {conversationId} (string, matches conversation.id)
//
// Fields:
//   - id: string (required) - Unique ID matching the conversation document ID (1-128 chars). Immutable on update.
//   - title: string (required) - Title of the conversation (1-200 chars).
//   - updatedAt: string or timestamp (required) - ISO 8601 date string or Firestore timestamp indicating last update.
//   - messages: list (required) - List of chat message maps (max 1000 messages) containing role, content, optional image, optional timestamp.
//
// Access Control:
//   - Users can only read, create, update, and delete their own conversations where request.auth.uid == userId.
//   - Supports both anonymous (guest) users and authenticated users (email/password, Google).
//   - Unauthenticated access is strictly denied.
//   - Default-deny all unmapped paths.
//   - Strict schema validation enforced on both create and update operations (Validator Function Pattern).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if user is authenticated (supports anonymous and authenticated sessions)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that all required fields are present in the document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that only allowed fields exist (strict schema enforcement)
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields have not been modified during update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate updatedAt is either a Firestore timestamp or a valid ISO 8601 date string
    function isValidUpdatedAt() {
      return (request.resource.data.updatedAt is timestamp) ||
             (request.resource.data.updatedAt is string &&
              request.resource.data.updatedAt.size() >= 19 &&
              request.resource.data.updatedAt.size() <= 40 &&
              request.resource.data.updatedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*'));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate conversation schema, types, and resource bounds
    function isValidConversation(conversationId) {
      return hasOnlyAllowedFields(['id', 'title', 'updatedAt', 'messages']) &&
             hasRequiredFields(['id', 'title', 'updatedAt', 'messages']) &&
             request.resource.data.id is string &&
             request.resource.data.id.size() >= 1 &&
             request.resource.data.id.size() <= 128 &&
             request.resource.data.id == conversationId &&
             request.resource.data.title is string &&
             request.resource.data.title.size() >= 1 &&
             request.resource.data.title.size() <= 200 &&
             isValidUpdatedAt() &&
             request.resource.data.messages is list &&
             request.resource.data.messages.size() <= 1000;
    }

    // Validate conversation update (applies validator function pattern & preserves immutables)
    function isValidConversationUpdate(conversationId) {
      return isValidConversation(conversationId) &&
             areImmutableFieldsUnchanged(['id']);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User conversations collection
    match /users/{userId}/conversations/{conversationId} {
      // Allow read (both get and list queries) only to the conversation owner
      allow read: if isOwner(userId);

      // Allow conversation creation only if user is owner and payload is valid
      allow create: if isOwner(userId) && isValidConversation(conversationId);

      // Allow conversation update only if user is owner, schema is valid, and immutable fields are untouched
      allow update: if isOwner(userId) && isValidConversationUpdate(conversationId);

      // Allow conversation deletion only to the conversation owner
      allow delete: if isOwner(userId);
    }
  }
}

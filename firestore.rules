rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User-scoped chat history
    match /users/{userId}/conversations/{conversationId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Public shared chat links
    match /shared_chats/{shareId} {
      // Anyone with the link can view the shared conversation
      allow read: if true;
      // Authenticated users (including anonymous guests) can create share links
      allow create: if isAuthenticated();
      // Only the creator can update or delete their shared link
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.creatorId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
